
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Listings | ComfyHere</title>
    <link rel="stylesheet" href="/css/style.css">
    <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar" >
        <a href="/listings" class="logo-link">
            <img src="/images/logo.png" alt="ComfyHere">
        </a>
         <!-- Search Bar -->
    <form action="/listings" method="GET" class="search-bar">
    <input
        type="text"
        name="search"
        placeholder="Search destinations..."
        value="<%= search || '' %>"
    >
    <button type="submit">🔍</button>
</form>

        <a href="/listings/new" class="create-btn">  Create Listing </a>
        <% if (currUser) { %>
    <div class="user-badge">
        <span class="user-icon">👤</span>
        <span><%= currUser.username %></span>
    </div>
<% } %>

<button id="theme-toggle" class="theme-toggle" type="button">
    🌙
</button>
        <div class="acc"> 
          <%  if(!currUser) { %>
            <a href="/signup" class="create-btn"> Sign up </a>
             <a href="/login" class="create-btn"> Log in </a>
          <% } %>
          <%  if(currUser) { %>
          <a href="/logout" class="create-btn"> Logout </a>
           <% } %>
        </div>
    </nav>


  <!-- Filters -->
<div class="filter-bar">

    <a href="/listings?category=Rooms"
       class="filter <%= category === 'Rooms' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-house"></i>
        </div>
        <span>Rooms</span>
    </a>

    <a href="/listings?category=Beach"
       class="filter <%= category === 'Beach' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-umbrella-beach"></i>
        </div>
        <span>Beach</span>
    </a>

    <a href="/listings?category=Mountains"
       class="filter <%= category === 'Mountains' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-mountain"></i>
        </div>
        <span>Mountains</span>
    </a>

    <a href="/listings?category=Pool"
       class="filter <%= category === 'Pool' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-person-swimming"></i>
        </div>
        <span>Pool</span>
    </a>

    <a href="/listings?category=Cabins"
       class="filter <%= category === 'Cabins' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-house-chimney"></i>
        </div>
        <span>Cabins</span>
    </a>

    <a href="/listings?category=Castles"
       class="filter <%= category === 'Castles' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-chess-rook"></i>
        </div>
        <span>Castles</span>
    </a>

    <a href="/listings?category=Nature"
       class="filter <%= category === 'Nature' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-tree"></i>
        </div>
        <span>Nature</span>
    </a>

    <a href="/listings?category=Camping"
       class="filter <%= category === 'Camping' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-campground"></i>
        </div>
        <span>Camping</span>
    </a>

    <a href="/listings?category=City"
       class="filter <%= category === 'City' ? 'active' : '' %>">
        <div class="filter-icon">
            <i class="fa-solid fa-city"></i>
        </div>
        <span>City</span>
    </a>

</div>

    <!-- Main Content -->
    <main class="container">
         <% if (success && success.length > 0) { %>
         <div class="success-message">
         <%= success[0] %>
          </div>
        <% } %>
        <div class="heading">

    <% if (category) { %>
        <div class="active-filter-label">
            <span>Showing</span>
            <strong><%= category %></strong>
        </div>
        <h2><%= category %> Stays</h2>
        <p>
            Discover amazing <%= category.toLowerCase() %> stays 
             <a href="/listings" class="clear-filter"> ✕ Clear filter </a>
        </p>
       
    <% } else { %>
        <h2>Explore All Stays</h2>
        <p>  Find your perfect stay ✨</p>
    <% } %>
</div>

<p class="result-count">
    <%= allListings.length %>
    <%= allListings.length === 1 ? 'stay' : 'stays' %>
    found
</p>
        <!-- Listings -->
        <div class="listing-grid">
            <% for(let list of allListings){ %>
                <div class="listing-card">
                    <!-- Image -->
                    <div class="listing-image">
                        <img  src="<%= list.image.url %>"  alt="<%= list.title %>" > </div>
                    <!-- Content -->
                    <div class="listing-content">
             <h3> <%= list.title %>   </h3>
                        <p class="listing-location">📍 <%= list.location %>, <%= list.country %>     </p>

                        <p class="listing-price">
                            ₹<%= list.price.toLocaleString("en-IN") %>
                            <span>/ night</span>
                        </p>
                        <a   href="/listings/<%= list._id %>"
                            class="view-btn" > View Listing →
                        </a>
                    </div>

                </div>

            <% } %>

        </div>

    </main>


    <!-- Footer -->
    <footer>

        <p>
            © 2026 ComfyHere. All rights reserved.
        </p>
    </footer>
    <script src="/js/theme.js"></script>

</body>

</html>




