<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Listing | ComfyHere</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar"> <div class="logo">  ComfyHere </div>
        <a href="/listings" class="back-btn"> All Listings
        </a>
    </nav>
    <main class="form-container">
        <div class="form-header">
            <p class="small-title">  ComfyHere
            </p>
            <h1>   Create a New Listing
            </h1>
            <p> Add a new place for travelers to discover ✨ </p>
        </div>
        <form method="POST" action="/listings" enctype="multipart/form-data">

    <div class="form-group">
        <label for="title">Listing Title</label>
        <input
            id="title"
            name="listing[title]"
            placeholder="Enter listing title"
            type="text"
            required>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea
            id="description"
            name="listing[description]"
            placeholder="Describe your listing..."
            required
        ></textarea>
    </div>


    <div class="form-group">
        <label for="image">Upload Image </label>
        <input
            id="image"
            name="listing[image]" 
            type="file"
             accept="image/*"
             required>
    </div>

    <div class="form-group">
        <label for="price">Price per night</label>
        <input
            id="price"
            name="listing[price]"
            placeholder="Enter price"
            type="number"
            min="0"
            required>
    </div>

    <div class="form-group">
        <label for="location">Location</label>
        <input
            id="location"
            name="listing[location]"
            placeholder="Enter location"
            type="text"
            required>
    </div>

    <div class="form-group">
        <label for="country">Country</label>
        <input
            id="country"
            name="listing[country]"
            placeholder="Enter country"
            type="text"
            required>
    </div>
    <div class="form-group">
    <label for="category">Category</label>

    <select
        id="category"
        name="listing[category]"
        required>

        <option value="">Select a category</option>
        <option value="Rooms">Rooms</option>
        <option value="Beach">Beach</option>
        <option value="Mountains">Mountains</option>
        <option value="Pool">Pool</option>
        <option value="Cabins">Cabins</option>
        <option value="Castles">Castles</option>
        <option value="Nature">Nature</option>
        <option value="Camping">Camping</option>
        <option value="City">City</option>

    </select>
</div>

    <button type="submit" class="submit-btn"> + Add Listing  </button>

</form>
    </main>
    <!-- Footer -->
    <footer>
        <p>© 2026 ComfyHere. All rights reserved.</p>
    </footer>
     <script src="/js/theme.js"></script>
</body>
</html>