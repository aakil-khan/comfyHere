<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> |ComfyHere</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.js">
    </script>
    <script>
    let mapToken = "<%= mapToken %>";
    let coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    let listingTitle = "<%= listing.title %>";

</script>



</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
         <img src="/images/logo.png" alt="ComfyHere">
        <a href="/listings" class="back-btn"> ← All Listings </a>
    
       <% if (currUser) { %>
    <div class="user-badge">
        <span class="user-icon">👤</span>
        <span><%= currUser.username %></span>
    </div>
<% } %>

    </nav>

<% if (success && success.length > 0) { %>
    <div class="alert alert-success">
        <%= success[0] %>
    </div>
<% } %>
<% if (error && error.length > 0) { %>
    <div class="alert alert-error">
        <%= error[0] %>
    </div>
<% } %>
    <main class="show-container">
        <div class="show-card">
            <div class="show-image-container">
                <img
                    src="<%= listing.image.url || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6' %>"
                    alt="<%= listing.title %>"
                    class="show-image" >
            </div>
            <div class="show-content">
                <p class="small-title">LISTING DETAILS</p>
                <h1><%= listing.title %></h1>
                <i> Owned By <%= listing.owner.username %> </i> <br>
                <p class="show-description"> <%= listing.description %> </p>
                <div class="details">
                    <div class="detail-item">
                        <span>💰 Price</span>
                        <strong>
                            ₹<%= listing.price.toLocaleString("en-IN") %>
                        </strong>
                    </div>
                    <div class="detail-item">
                        <span>📍 Location</span>
                        <strong>
                            <%= listing.location %>
                        </strong>
                    </div>
                    <div class="detail-item">
                        <span>🌎 Country</span>
                        <strong>
                            <%= listing.country %>
                        </strong>
                    </div>
                </div>
             <%  if( currUser && currUser._id.equals(listing.owner._id)) { %>
                <div class="action-buttons">
                    <a href="/listings/<%= listing._id %>/edit" class="edit-btn" > ✏️ Edit Listing
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" > <button type="submit"
                        class="delete-btn"> 🗑️ Delete </button>
                    </form>
                 </div>
             <% } %>
            
            </div>
        </div>
    </main>
     
   <% if(currUser) { %>
    <div class="review-container">
    <div class="review-card">
        <h4>Leave a review</h4>
        <form 
            action="/listings/<%= listing._id %>/reviews" method="POST">
        
            <div class="review-group">
    <label>Rating</label>
     
    <div class="star-rating">

    <input type="radio" id="star5" name="review[rating]" value="5">
    <label for="star5">★</label>

    <input type="radio" id="star4" name="review[rating]" value="4">
    <label for="star4">★</label>

    <input type="radio" id="star3" name="review[rating]" value="3">
    <label for="star3">★</label>

    <input type="radio" id="star2" name="review[rating]" value="2">
    <label for="star2">★</label>

    <input type="radio" id="star1" name="review[rating]" value="1" required>
    <label for="star1">★</label>

</div>
  
</div>
            <div class="review-group">
                <label for="comment">Comments</label>
                <textarea
                  name="review[comment]"  id="comment"  rows="6"  required   placeholder="Share your experience..." ></textarea>
            </div>
            <button type="submit" class="review-submit">
                Submit Review
            </button>
        </form>
    </div>
</div>
<% } %>

     <div class="reviews-section">

    <h2>Reviews</h2>
    <% if (!listing.reviews || listing.reviews.length === 0) { %>
        <p class="no-reviews">No reviews yet.</p>
    <% } else { %>
        <div class="reviews-grid">
            <% listing.reviews.forEach(review => { %>
                <div class="review-card">
                   <p><i>@<%= review.author.username %> </i> </p>
                    <div class="review-rating">⭐ <%= review.rating %>/5 </div>
                    <p class="review-comment"> <%= review.comment %></p>
                     <form method="POST"
                           action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                           <button type="submit" class="review-delete-btn">
                            🗑️ Delete Review </button>
                      </form>
                </div>
            <% }) %>
            
        </div>
    <% } %>
    
</div>
   <div class="reviews-section"> <h3> Where you'll be </h3>
     <div id="map"></div>
      <script src="/js/map.js"></script>
     </div>


</div>
    <footer>
        <p>© 2026 ComfyHere. All rights reserved.</p>
    </footer>
</body>
</html> 